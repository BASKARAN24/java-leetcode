class Solution {
    public boolean isPalindrome(int x) {
        int a = x;
        int b = 0;
        if(x>=0)
        {
         while(x!=0)
        {
            int mod = x%10;
            b = b*10+mod;
            x /= 10;
        }
        if(b==a) return true;
        else return false;
        }
        else return false;
    }
}
